# Serenity Salon & Spa ERP SaaS - Environment Template
# Copy this to .env.local and fill in real values.

# --- Database (XAMPP MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=gech_salon_db

# --- Authentication ---
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- SMS Gateway (optional) ---
SMS_PROVIDER=log                # "log" (simulated) | "http" (real gateway)
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER_ID=Serenity

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development